{
  "info": {
    "name": "Lab03 - Team Vision Contract Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Contract test collection for AI Vision based on Lab 02 OpenAPI"
  },
  "item": [
    {"name":"00_Health","item":[{"name":"GET /health","request":{"method":"GET","url":"{{baseUrl}}/health"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('200',()=>pm.response.to.have.status(200));","const j=pm.response.json(); pm.test('health body',()=>{pm.expect(j.status).to.eql('ok'); pm.expect(j).to.have.property('service');});"]}}]}]},
    {"name":"01_Functional","item":[
      {"name":"POST /vision/detect happy path","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{authToken}}"}],"url":"{{baseUrl}}/vision/detect","body":{"mode":"raw","raw":"{\n  \"requestId\": \"REQ-CAM-20260512-0001\",\n  \"cameraId\": \"CAM-ER-01\",\n  \"capturedAt\": \"2026-05-12T08:00:00Z\",\n  \"traceId\": \"TRACE-20260512-0001\",\n  \"zoneId\": \"ER-ENTRANCE\",\n  \"motionLevel\": 0.92,\n  \"imageSource\": {\n    \"sourceType\": \"IMAGE_URL\",\n    \"url\": \"https://media.hospital.local/camera/CAM-ER-01/frame-1001.jpg\"\n  }\n}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('202',()=>pm.response.to.have.status(202));","const j=pm.response.json(); pm.test('has detectionId',()=>pm.expect(j).to.have.property('detectionId'));","pm.collectionVariables.set('detectionId', pm.response.json().detectionId || 'DET-20260512-0001');"]}}]},
      {"name":"GET /vision/detections/{id}","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{authToken}}"}],"url":"{{baseUrl}}/vision/detections/{{detectionId}}"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('200',()=>pm.response.to.have.status(200));","const j=pm.response.json(); pm.test('result fields',()=>{pm.expect(j).to.have.property('status'); pm.expect(j).to.have.property('confidence');});"]}}]},
      {"name":"GET /vision/models/info","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{authToken}}"}],"url":"{{baseUrl}}/vision/models/info"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('200',()=>pm.response.to.have.status(200));","const j=pm.response.json(); pm.test('model fields',()=>{pm.expect(j).to.have.property('modelName'); pm.expect(j).to.have.property('maxImageSizeBytes');});"]}}]}
    ]},
    {"name":"02_Auth","item":[
      {"name":"Detect with valid token","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{authToken}}"}],"url":"{{baseUrl}}/vision/detect","body":{"mode":"raw","raw":"{{validDetectBody}}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('valid token accepted',()=>pm.expect([200,202]).to.include(pm.response.code));"]}}]},
      {"name":"Detect missing token","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/vision/detect","body":{"mode":"raw","raw":"{{validDetectBody}}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["const env=pm.environment.get('env'); if(env==='local'){pm.test('401/403',()=>pm.expect([401,403]).to.include(pm.response.code));} else {pm.test('mock skip',()=>pm.expect(true).to.be.true);} "]}}]},
      {"name":"Detect invalid token","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer wrong-token"}],"url":"{{baseUrl}}/vision/detect","body":{"mode":"raw","raw":"{{validDetectBody}}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["const env=pm.environment.get('env'); if(env==='local'){pm.test('401/403',()=>pm.expect([401,403]).to.include(pm.response.code));} else {pm.test('mock skip',()=>pm.expect(true).to.be.true);} "]}}]}
    ]},
    {"name":"03_Negative","item":[
      {"name":"Missing required field","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{authToken}}"},{"key":"Prefer","value":"code=400"}],"url":"{{baseUrl}}/vision/detect","body":{"mode":"raw","raw":"{\n  \"cameraId\": \"CAM-ER-01\"\n}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('4xx',()=>pm.expect([400,422]).to.include(pm.response.code));","const j=pm.response.json(); pm.test('problem details',()=>pm.expect(j.status).to.be.within(400,599));"]}}]},
      {"name":"Wrong sourceType enum","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{authToken}}"},{"key":"Prefer","value":"code=422"}],"url":"{{baseUrl}}/vision/detect","body":{"mode":"raw","raw":"{\n  \"requestId\": \"REQ-CAM-20260512-0001\",\n  \"cameraId\": \"CAM-ER-01\",\n  \"capturedAt\": \"2026-05-12T08:00:00Z\",\n  \"traceId\": \"TRACE-20260512-0001\",\n  \"zoneId\": \"ER-ENTRANCE\",\n  \"motionLevel\": 0.92,\n  \"imageSource\": {\n    \"sourceType\": \"BAD\"\n  }\n}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('4xx',()=>pm.expect([400,422]).to.include(pm.response.code));"]}}]}
    ]},
    {"name":"04_Boundary_Reliability","item":[
      {"name":"motionLevel=1 boundary accepted","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{authToken}}"}],"url":"{{baseUrl}}/vision/detect","body":{"mode":"raw","raw":"{\n  \"requestId\": \"REQ-CAM-20260512-0099\",\n  \"cameraId\": \"CAM-ER-01\",\n  \"capturedAt\": \"2026-05-12T08:00:00Z\",\n  \"traceId\": \"TRACE-20260512-0099\",\n  \"zoneId\": \"ER-ENTRANCE\",\n  \"motionLevel\": 1,\n  \"imageSource\": {\n    \"sourceType\": \"IMAGE_URL\",\n    \"url\": \"https://media.hospital.local/camera/CAM-ER-01/frame-1001.jpg\"\n  }\n}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('202',()=>pm.response.to.have.status(202));"]}}]},
      {"name":"motionLevel>1 rejected","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{authToken}}"},{"key":"Prefer","value":"code=422"}],"url":"{{baseUrl}}/vision/detect","body":{"mode":"raw","raw":"{\n  \"requestId\": \"REQ-CAM-20260512-0100\",\n  \"cameraId\": \"CAM-ER-01\",\n  \"capturedAt\": \"2026-05-12T08:00:00Z\",\n  \"traceId\": \"TRACE-20260512-0100\",\n  \"zoneId\": \"ER-ENTRANCE\",\n  \"motionLevel\": 1.1,\n  \"imageSource\": {\n    \"sourceType\": \"IMAGE_URL\",\n    \"url\": \"https://media.hospital.local/camera/CAM-ER-01/frame-1001.jpg\"\n  }\n}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('4xx',()=>pm.expect([400,422]).to.include(pm.response.code));"]}}]},
      {"name":"Response time check","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{authToken}}"}],"url":"{{baseUrl}}/vision/models/info"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["if(pm.environment.get('env')==='local'){pm.test('response < 1000ms',()=>pm.expect(pm.response.responseTime).to.be.below(1000));} else {pm.test('mock latency skip',()=>pm.expect(true).to.be.true);} "]}}]}
    ]},
    {"name":"05_Consumer_side_Smoke","item":[
      {"name":"Call IoT mock dependency","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{authToken}}"}],"url":"{{iotMockUrl}}/health"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('dependency reachable',()=>pm.response.to.have.status(200));","const j=pm.response.json(); pm.test('can parse provider fields',()=>pm.expect(j).to.have.property('status'));" ]}}]}
    ]},
    {"name":"06_Local_only_NonFunctional","item":[
      {"name":"Repeated detect call stability note","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{authToken}}"}],"url":"{{baseUrl}}/vision/detect","body":{"mode":"raw","raw":"{{validDetectBody}}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('request succeeds',()=>pm.expect([200,202]).to.include(pm.response.code));","if(pm.environment.get('env')==='local'){pm.test('idempotency/retry policy documented externally',()=>pm.expect(true).to.be.true);} else {pm.test('mock run',()=>pm.expect(true).to.be.true);} "]}}]}
    ]}
  ],
  "variable": [
    {"key":"detectionId","value":"DET-20260512-0001"},
    {"key":"validDetectBody","value":"{\n  \"requestId\": \"REQ-CAM-20260512-0001\",\n  \"cameraId\": \"CAM-ER-01\",\n  \"capturedAt\": \"2026-05-12T08:00:00Z\",\n  \"traceId\": \"TRACE-20260512-0001\",\n  \"zoneId\": \"ER-ENTRANCE\",\n  \"motionLevel\": 0.92,\n  \"imageSource\": {\n    \"sourceType\": \"IMAGE_URL\",\n    \"url\": \"https://media.hospital.local/camera/CAM-ER-01/frame-1001.jpg\"\n  }\n}"}
  ]
}
